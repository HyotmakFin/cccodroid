  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "The UI only subscribes: runs belong to the gateway and survive reloads and backgrounding",
        "Queued messages wait at the end of the chat; Stop only stops",
        "Claude Code is the official build, byte-for-byte unmodified"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Gateway /api/* requires a 256-bit token; Host and Origin are checked",
        "Signed-in sessions talk to Anthropic directly, never through a local relay",
        "priv only accepts calls from the app's own uid"
      ]
    },
    {
      "dot": "cyan",
      "title": "Toolchain",
      "items": [
        "devkit is assembled from official Termux packages and relocated in place (same-length prefix)",
        "Entries inside zip/jmod archives are relocated too"
      ]
    }
  ]

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.codroid"
    android:versionCode="22"
    android:versionName="0.2.0-rc1">

    <!-- targetSdk 28：29 起禁止执行应用可写目录里的程序（W^X），整套原生工具链就跑不了 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- 保活：前台服务 + 部分唤醒锁 + 申请忽略电池优化 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shizuku：调试提权（以 shell 身份执行），见 Priv.java -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 自更新、一键装 Shizuku：PackageInstaller 会话（每次仍由用户在系统弹窗里确认），见 Apk.java -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 大件更新只在不计流量的网络上自动下；Shizuku 无线调试激活要知道连没连 Wi‑Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 开机后自动重新激活 Shizuku（用户可在设置页关掉），见 SysEvents.java -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 普通应用拿不到；Shizuku 激活后由 shell 授予，用来在重启后自己打开无线调试，见 ShizukuSetup.java -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 无线调试配对：让带输入框的通知常驻屏幕顶部（配对码对话框一切走就作废），见 ShizukuSetup.pairNote -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="cccodroid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 应用内浏览器（系统 WebView，见 BrowserActivity.java）：分屏 / 转屏不重建，免得页面重载 -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|navigation" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Launch"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku-API（MIT）：Shizuku 经这个 provider 把 binder 递给我们 -->
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="cc.codroid.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 往外分享文件（会话导出包、日志包）：不导出，只靠分享时一次性的读授权 -->
        <provider
            android:name=".Share"
            android:authorities="cc.codroid.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 应用内部回调：安装结果、通知栏填的配对码。不导出 -->
        <receiver android:name=".Events" android:exported="false" />
        <!-- 系统广播：自更新装完、开机 -->
        <receiver android:name=".SysEvents" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 网关的宿主：前台服务。界面关了、切后台、锁屏，正在跑的任务都不断 -->
        <!-- 导出但要求 INTERACT_ACROSS_USERS_FULL：只有 shell / 系统能启动（静默自更新装完由 shell 拉起服务，
             国产 ROM 会拦掉 MY_PACKAGE_REPLACED）。普通应用拿不到这个权限 -->
        <service
            android:name=".GatewayService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.codroid"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!-- targetSdk 28：29 起禁止执行应用可写目录里的程序（W^X），整套原生工具链就跑不了 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- 保活：前台服务 + 部分唤醒锁 + 申请忽略电池优化 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shizuku：调试提权（以 shell 身份执行），见 Priv.java -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:label="cccodroid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku-API（MIT）：Shizuku 经这个 provider 把 binder 递给我们 -->
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="cc.codroid.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 网关的宿主：前台服务。界面关了、切后台、锁屏，正在跑的任务都不断 -->
        <service
            android:name=".GatewayService"
            android:exported="false" />
    </application>
</manifest>

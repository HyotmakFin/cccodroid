#!/system/bin/sh
# 让**静态二进制**也能吃到 seccomp 垫片。
#
# seccomp-enosys.so 靠 ld-linux 的 --preload 注入，只对动态链接的程序有效；
# 静态二进制（典型是 Go CLI：gh / lazygit / kubectl / terraform …）没有动态加载器，
# 一跑就 SIGSYS。这个命令用 ptrace 从外面做同样的事，**不改动目标程序**。
#
#   enosys-run <程序> [参数...]
#   enosys-run -v gh pr create --fill     # 看拦截了什么
#
# 原理与适用场景见 android/native/seccomp-enosys-run.c 顶部注释。
# 路径自己推导（和 priv 一样用 dirname "$0"）：不依赖 CCAPP_BIN —— 它指向别处时
# 会让这个命令悄悄跑错二进制。
exec "$(dirname "$0")/../lib/seccomp-enosys-run" "$@"

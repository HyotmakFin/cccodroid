#!/system/bin/sh
# which：开发工具包 10.22 没带 debianutils（没有 which），这里补一个按 PATH 找命令的最小实现（-a 列出全部）
all=0; rc=0
[ "$1" = "-a" ] && { all=1; shift; }
[ $# -gt 0 ] || { echo "用法: which [-a] 命令…" >&2; exit 2; }
for c in "$@"; do
  found=0
  case $c in
    */*) [ -f "$c" ] && [ -x "$c" ] && { echo "$c"; found=1; } ;;
    *)
      IFS=:
      for d in $PATH; do
        [ -n "$d" ] || d=.
        if [ -f "$d/$c" ] && [ -x "$d/$c" ]; then echo "$d/$c"; found=1; [ $all = 1 ] || break; fi
      done
      unset IFS ;;
  esac
  [ $found = 1 ] || rc=1
done
exit $rc

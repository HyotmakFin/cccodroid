#!/system/bin/sh
# 官方 Claude Code（原样二进制，经 devkit 的 glibc 加载器运行）。
# 先清掉 LD_PRELOAD：shell 里的 termux-exec 是 bionic 库，glibc 进程继承到它会直接起不来。
# --preload 的小库把"被安卓 seccomp 拦下的调用"改成返回 ENOSYS（Android 14 拦 epoll_pwait2，不挂它 claude 一跑就 SIGSYS）。
unset LD_PRELOAD
# 经加载器时（targetSdk 36）：ld.so 用 APK 里那份（CCAPP_LD），预加载列表多一个 exec-shim.so（CCAPP_GLIBC_PRELOAD）
PRE=${CCAPP_GLIBC_PRELOAD:-${CCAPP_CLAUDE_PRELOAD:-${CCAPP_BIN%/bin}/lib/seccomp-enosys.so}}
exec "${CCAPP_LD:-$PREFIX/glibc/lib/ld-linux-aarch64.so.1}" --library-path "$PREFIX/glibc/lib" ${PRE:+--preload "$PRE"} \
  "$HOME/.local/share/cccodroid/claude/current/claude" "$@"
